generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  MEMBRO
  LIDER
}

enum ScopeType {
  GLOBAL
  GRE
}

model Person {
  id          String        @id @default(uuid()) @db.Uuid
  displayName String        @map("display_name") @db.VarChar(160)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  users       UserAccount[]

  @@map("person")
}

model UserAccount {
  id                   String              @id @default(uuid()) @db.Uuid
  personId             String              @unique @map("person_id") @db.Uuid
  loginIdentifier      String              @unique @map("login_identifier") @db.VarChar(160)
  status               UserStatus          @default(ACTIVE)
  isTechnicalSuperuser Boolean             @default(false) @map("is_technical_superuser")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  person               Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  memberships          TeamMembership[]
  passwordCredential   PasswordCredential?
  sessions             UserSession[]

  @@index([personId])
  @@map("user_account")
}

model PasswordCredential {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @unique @map("user_id") @db.Uuid
  passwordHash      String      @map("password_hash") @db.Text
  passwordUpdatedAt DateTime    @default(now()) @map("password_updated_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  user              UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_credential")
}

model UserSession {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  sessionTokenHash String      @unique @map("session_token_hash") @db.Text
  userAgent        String?     @map("user_agent") @db.VarChar(512)
  ipAddress        String?     @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime    @map("expires_at")
  revokedAt        DateTime?   @map("revoked_at")
  lastSeenAt       DateTime    @default(now()) @map("last_seen_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  user             UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_session")
}

model Team {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(120)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  memberships TeamMembership[]

  @@map("team")
}

model TeamMembership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  teamId    String         @map("team_id") @db.Uuid
  role      MembershipRole
  scopeType ScopeType      @map("scope_type")
  greCode   String?        @map("gre_code") @db.VarChar(32)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      UserAccount    @relation(fields: [userId], references: [id], onDelete: Restrict)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([teamId])
  @@index([userId])
  @@index([scopeType, greCode])
  @@map("team_membership")
}
