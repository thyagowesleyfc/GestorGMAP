generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  MEMBRO
  LIDER
}

enum ScopeType {
  GLOBAL
  GRE
}

enum EntityType {
  ESCOLA
  ANEXO
  SALA_ESCOLAR_AVULSA
  SECRETARIA
  SUPERINTENDENCIA
  DIRETORIA
  GERENCIA
  COORDENACAO
  UNIDADE
  REGIONAL_GRE
  SETOR
  PREFEITURA
  ASSOCIACAO
  INSTITUICAO_FILANTROPICA
}

enum MaterialControlType {
  INDIVIDUAL
  QUANTITATIVO
  CONSUMO
}

enum ContractDesignationRole {
  GESTOR
  FISCAL
}

enum ContractChangeType {
  ADITIVO
  APOSTILAMENTO
}

enum ContractBalanceMovementType {
  CONTRATACAO
  ADITIVO
  APOSTILAMENTO
  AJUSTE
}

enum SupplyOrderStatus {
  EMITIDA
  CANCELADA
}

enum SupplyOrderCancellationStatus {
  PREPARADA
  AUTORIZADA
  EFETIVADA
  REJEITADA
}

enum MaterialConfigurationType {
  KIT
  COMPOSTO
}

model Person {
  id          String        @id @default(uuid()) @db.Uuid
  displayName String        @map("display_name") @db.VarChar(160)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  users       UserAccount[]

  @@map("person")
}

model UserAccount {
  id                   String                    @id @default(uuid()) @db.Uuid
  personId             String                    @unique @map("person_id") @db.Uuid
  loginIdentifier      String                    @unique @map("login_identifier") @db.VarChar(160)
  status               UserStatus                @default(ACTIVE)
  isTechnicalSuperuser Boolean                   @default(false) @map("is_technical_superuser")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  person               Person                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  memberships          TeamMembership[]
  passwordCredential   PasswordCredential?
  passwordRecoveries   PasswordRecoveryRequest[]
  sessions             UserSession[]

  @@index([personId])
  @@map("user_account")
}

model PasswordCredential {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @unique @map("user_id") @db.Uuid
  passwordHash      String      @map("password_hash") @db.Text
  passwordUpdatedAt DateTime    @default(now()) @map("password_updated_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  user              UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_credential")
}

model PasswordRecoveryRequest {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  recoveryTokenHash String      @unique @map("recovery_token_hash") @db.Text
  expiresAt         DateTime    @map("expires_at")
  usedAt            DateTime?   @map("used_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  user              UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_recovery_request")
}

model UserSession {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  sessionTokenHash String      @unique @map("session_token_hash") @db.Text
  userAgent        String?     @map("user_agent") @db.VarChar(512)
  ipAddress        String?     @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime    @map("expires_at")
  revokedAt        DateTime?   @map("revoked_at")
  lastSeenAt       DateTime    @default(now()) @map("last_seen_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  user             UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_session")
}

model Team {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(120)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  memberships TeamMembership[]

  @@map("team")
}

model TeamMembership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  teamId    String         @map("team_id") @db.Uuid
  role      MembershipRole
  scopeType ScopeType      @map("scope_type")
  greCode   String?        @map("gre_code") @db.VarChar(32)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      UserAccount    @relation(fields: [userId], references: [id], onDelete: Restrict)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  gre       Gre?           @relation(fields: [greCode], references: [code], onDelete: Restrict)

  @@index([teamId])
  @@index([userId])
  @@index([scopeType, greCode])
  @@map("team_membership")
}

model Gre {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(32)
  name            String           @db.VarChar(160)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  entities        Entity[]
  municipalities  Municipality[]
  teamMemberships TeamMembership[]

  @@map("gre")
}

model Municipality {
  id        String   @id @default(uuid()) @db.Uuid
  ibgeCode  String   @unique @map("ibge_code") @db.VarChar(7)
  name      String   @db.VarChar(160)
  greId     String   @map("gre_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  gre       Gre      @relation(fields: [greId], references: [id], onDelete: Restrict)
  entities  Entity[]

  @@unique([id, greId])
  @@index([greId])
  @@map("municipality")
}

model Entity {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique @db.VarChar(64)
  name           String        @db.VarChar(180)
  entityType     EntityType    @map("entity_type")
  greId          String        @map("gre_id") @db.Uuid
  municipalityId String?       @map("municipality_id") @db.Uuid
  parentEntityId String?       @map("parent_entity_id") @db.Uuid
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  gre            Gre           @relation(fields: [greId], references: [id], onDelete: Restrict)
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  parentEntity   Entity?       @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: Restrict)
  childEntities  Entity[]      @relation("EntityHierarchy")

  @@index([entityType])
  @@index([greId])
  @@index([municipalityId])
  @@index([parentEntityId])
  @@map("entity")
}

model MaterialClass {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique @db.VarChar(64)
  name              String             @db.VarChar(160)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  singularMaterials MaterialSingular[]

  @@map("material_class")
}

model MaterialSingular {
  id                          String                           @id @default(uuid()) @db.Uuid
  code                        String                           @unique @db.VarChar(64)
  name                        String                           @db.VarChar(180)
  classId                     String                           @map("class_id") @db.Uuid
  controlType                 MaterialControlType              @map("control_type")
  isTombable                  Boolean                          @default(false) @map("is_tombable")
  patrimonialGroupCode        String?                          @map("patrimonial_group_code") @db.VarChar(64)
  allowsCorrectiveMaintenance Boolean                          @default(false) @map("allows_corrective_maintenance")
  allowsPreventiveMaintenance Boolean                          @default(false) @map("allows_preventive_maintenance")
  allowsReconditioning        Boolean                          @default(false) @map("allows_reconditioning")
  allowsReplacement           Boolean                          @default(false) @map("allows_replacement")
  active                      Boolean                          @default(true)
  createdAt                   DateTime                         @default(now()) @map("created_at")
  updatedAt                   DateTime                         @updatedAt @map("updated_at")
  materialClass               MaterialClass                    @relation(fields: [classId], references: [id], onDelete: Restrict)
  configurationComponents     MaterialConfigurationComponent[]
  contractItems               ContractItem[]

  @@index([classId])
  @@index([controlType])
  @@map("material_singular")
}

model MaterialConfiguration {
  id                String                           @id @default(uuid()) @db.Uuid
  code              String                           @unique @db.VarChar(64)
  name              String                           @db.VarChar(180)
  configurationType MaterialConfigurationType        @map("configuration_type")
  active            Boolean                          @default(true)
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")
  components        MaterialConfigurationComponent[]
  contractItems     ContractItem[]

  @@index([configurationType])
  @@map("material_configuration")
}

model MaterialConfigurationComponent {
  id                 String                @id @default(uuid()) @db.Uuid
  configurationId    String                @map("configuration_id") @db.Uuid
  materialSingularId String                @map("material_singular_id") @db.Uuid
  quantity           Int
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  configuration      MaterialConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  materialSingular   MaterialSingular      @relation(fields: [materialSingularId], references: [id], onDelete: Restrict)

  @@unique([configurationId, materialSingularId], map: "material_configuration_component_unique_item")
  @@index([materialSingularId])
  @@map("material_configuration_component")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(64)
  name      String     @db.VarChar(180)
  taxId     String?    @unique @map("tax_id") @db.VarChar(14)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  contracts Contract[]

  @@map("supplier")
}

model Contract {
  id            String                @id @default(uuid()) @db.Uuid
  code          String                @unique @db.VarChar(64)
  supplierId    String                @map("supplier_id") @db.Uuid
  object        String                @db.VarChar(500)
  validityStart DateTime              @map("validity_start") @db.Date
  validityEnd   DateTime              @map("validity_end") @db.Date
  active        Boolean               @default(true)
  version       Int                   @default(1)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  supplier      Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         ContractItem[]
  designations  ContractDesignation[]
  changes       ContractChange[]
  supplyOrders  SupplyOrder[]

  @@index([supplierId])
  @@map("contract")
}

model ContractItem {
  id                      String                    @id @default(uuid()) @db.Uuid
  code                    String                    @unique @db.VarChar(64)
  contractId              String                    @map("contract_id") @db.Uuid
  lineNumber              Int                       @map("line_number")
  materialSingularId      String?                   @map("material_singular_id") @db.Uuid
  materialConfigurationId String?                   @map("material_configuration_id") @db.Uuid
  contractedQuantity      Int                       @map("contracted_quantity")
  unitPrice               Decimal                   @map("unit_price") @db.Decimal(14, 2)
  active                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  contract                Contract                  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  materialSingular        MaterialSingular?         @relation(fields: [materialSingularId], references: [id], onDelete: Restrict)
  materialConfiguration   MaterialConfiguration?    @relation(fields: [materialConfigurationId], references: [id], onDelete: Restrict)
  balanceMovements        ContractBalanceMovement[]
  balancePosition         ContractBalancePosition?
  supplyOrderItems        SupplyOrderItem[]

  @@unique([contractId, lineNumber], map: "contract_item_contract_line_number_key")
  @@unique([id, contractId], map: "contract_item_id_contract_id_key")
  @@index([contractId])
  @@index([materialSingularId])
  @@index([materialConfigurationId])
  @@map("contract_item")
}

model ContractDesignation {
  id             String                  @id @default(uuid()) @db.Uuid
  contractId     String                  @map("contract_id") @db.Uuid
  role           ContractDesignationRole
  holderName     String                  @map("holder_name") @db.VarChar(180)
  holderDocument String?                 @map("holder_document") @db.VarChar(14)
  startsOn       DateTime                @map("starts_on") @db.Date
  endsOn         DateTime?               @map("ends_on") @db.Date
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  contract       Contract                @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([role])
  @@index([contractId, role, startsOn, endsOn], map: "contract_designation_temporal_lookup_idx")
  @@map("contract_designation")
}

model ContractChange {
  id               String                    @id @default(uuid()) @db.Uuid
  contractId       String                    @map("contract_id") @db.Uuid
  type             ContractChangeType
  code             String                    @unique @db.VarChar(64)
  summary          String                    @db.VarChar(500)
  effectiveOn      DateTime                  @map("effective_on") @db.Date
  signedOn         DateTime?                 @map("signed_on") @db.Date
  processReference String?                   @map("process_reference") @db.VarChar(120)
  active           Boolean                   @default(true)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  contract         Contract                  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  balanceMovements ContractBalanceMovement[]

  @@index([contractId])
  @@index([type])
  @@index([contractId, effectiveOn], map: "contract_change_contract_effective_lookup_idx")
  @@map("contract_change")
}

model ContractBalanceMovement {
  id               String                      @id @default(uuid()) @db.Uuid
  code             String                      @unique @db.VarChar(80)
  contractItemId   String                      @map("contract_item_id") @db.Uuid
  contractChangeId String?                     @map("contract_change_id") @db.Uuid
  type             ContractBalanceMovementType
  quantityDelta    Int                         @map("quantity_delta")
  amountDelta      Decimal                     @map("amount_delta") @db.Decimal(14, 2)
  occurredAt       DateTime                    @map("occurred_at")
  summary          String                      @db.VarChar(500)
  createdAt        DateTime                    @default(now()) @map("created_at")
  contractItem     ContractItem                @relation(fields: [contractItemId], references: [id], onDelete: Restrict)
  contractChange   ContractChange?             @relation(fields: [contractChangeId], references: [id], onDelete: Restrict)

  @@index([contractItemId])
  @@index([contractChangeId])
  @@index([type])
  @@index([contractItemId, occurredAt], map: "contract_balance_movement_item_time_idx")
  @@map("contract_balance_movement")
}

model ContractBalancePosition {
  id                String       @id @default(uuid()) @db.Uuid
  contractItemId    String       @unique @map("contract_item_id") @db.Uuid
  totalQuantity     Int          @map("total_quantity")
  committedQuantity Int          @default(0) @map("committed_quantity")
  availableQuantity Int          @map("available_quantity")
  totalAmount       Decimal      @map("total_amount") @db.Decimal(14, 2)
  committedAmount   Decimal      @default(0) @map("committed_amount") @db.Decimal(14, 2)
  availableAmount   Decimal      @map("available_amount") @db.Decimal(14, 2)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  contractItem      ContractItem @relation(fields: [contractItemId], references: [id], onDelete: Restrict)

  @@map("contract_balance_position")
}

model SupplyOrder {
  id           String                   @id @default(uuid()) @db.Uuid
  code         String                   @unique @db.VarChar(64)
  contractId   String                   @map("contract_id") @db.Uuid
  status       SupplyOrderStatus        @default(EMITIDA)
  issuedAt     DateTime                 @map("issued_at")
  version      Int                      @default(1)
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  contract     Contract                 @relation(fields: [contractId], references: [id], onDelete: Restrict)
  items        SupplyOrderItem[]
  cancellation SupplyOrderCancellation?

  @@unique([id, contractId], map: "supply_order_id_contract_id_key")
  @@index([contractId])
  @@index([status])
  @@map("supply_order")
}

model SupplyOrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  supplyOrderId  String       @map("supply_order_id") @db.Uuid
  contractId     String       @map("contract_id") @db.Uuid
  contractItemId String       @map("contract_item_id") @db.Uuid
  lineNumber     Int          @map("line_number")
  quantity       Int
  unitPrice      Decimal      @map("unit_price") @db.Decimal(14, 2)
  totalAmount    Decimal      @map("total_amount") @db.Decimal(14, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  supplyOrder    SupplyOrder  @relation(fields: [supplyOrderId], references: [id], onDelete: Restrict)
  contractItem   ContractItem @relation(fields: [contractItemId], references: [id], onDelete: Restrict)

  @@unique([supplyOrderId, lineNumber], map: "supply_order_item_order_line_key")
  @@index([contractId])
  @@index([contractItemId])
  @@map("supply_order_item")
}

model SupplyOrderCancellation {
  id            String                        @id @default(uuid()) @db.Uuid
  supplyOrderId String                        @unique @map("supply_order_id") @db.Uuid
  status        SupplyOrderCancellationStatus @default(PREPARADA)
  reason        String                        @db.VarChar(500)
  preparedAt    DateTime                      @map("prepared_at")
  authorizedAt  DateTime?                     @map("authorized_at")
  effectiveAt   DateTime?                     @map("effective_at")
  rejectedAt    DateTime?                     @map("rejected_at")
  createdAt     DateTime                      @default(now()) @map("created_at")
  updatedAt     DateTime                      @updatedAt @map("updated_at")
  supplyOrder   SupplyOrder                   @relation(fields: [supplyOrderId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("supply_order_cancellation")
}
