{
  "openapi": "3.1.0",
  "info": {
    "title": "GESTOR GMAP API",
    "version": "0.1.0",
    "description": "Contrato dos endpoints implementados do GESTOR GMAP."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Ambiente local de desenvolvimento"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Verifica se a aplicacao esta respondendo",
        "tags": ["Operacao"],
        "responses": {
          "200": {
            "description": "Aplicacao respondendo.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthPayload"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "service": "gestor-gmap",
                      "status": "ok",
                      "timestamp": "2026-09-11T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro tecnico inesperado. A resposta nao expoe detalhe interno.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayload"
                },
                "examples": {
                  "internalError": {
                    "value": {
                      "error": "Erro interno do servidor.",
                      "correlation_id": "019a0000-0000-7000-8000-000000000000"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Verifica se a aplicacao esta pronta para receber trafego",
        "tags": ["Operacao"],
        "responses": {
          "200": {
            "description": "Aplicacao pronta e banco de dados disponivel.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessPayload"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "service": "gestor-gmap",
                      "status": "ok",
                      "timestamp": "2026-09-11T12:00:00.000Z",
                      "dependencies": {
                        "database": "ok"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro tecnico inesperado. A resposta nao expoe detalhe interno.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayload"
                },
                "examples": {
                  "internalError": {
                    "value": {
                      "error": "Erro interno do servidor.",
                      "correlation_id": "019a0000-0000-7000-8000-000000000000"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Aplicacao indisponivel por falha em dependencia obrigatoria.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessPayload"
                },
                "examples": {
                  "databaseError": {
                    "value": {
                      "service": "gestor-gmap",
                      "status": "error",
                      "timestamp": "2026-09-11T12:00:00.000Z",
                      "dependencies": {
                        "database": "error"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "postAuthLogin",
        "summary": "Autentica usuario e cria sessao server-side",
        "tags": ["Autenticacao"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "credentials": {
                  "value": {
                    "loginIdentifier": "usuario.gmap",
                    "password": "SenhaForte123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado. O token de sessao e enviado somente por cookie HttpOnly.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "Set-Cookie": {
                "$ref": "#/components/headers/SessionCookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccessPayload"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "ok": true,
                      "expires_at": "2026-09-14T20:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisicao invalida.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleErrorPayload"
                },
                "examples": {
                  "invalidPayload": {
                    "value": {
                      "error": "Informe identificador de login e senha."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais invalidas ou usuario sem acesso ativo.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleErrorPayload"
                },
                "examples": {
                  "invalidCredentials": {
                    "value": {
                      "error": "Credenciais invalidas."
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Muitas tentativas de login em uma janela curta.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleErrorPayload"
                },
                "examples": {
                  "rateLimited": {
                    "value": {
                      "error": "Muitas tentativas de login. Tente novamente mais tarde."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro tecnico inesperado. A resposta nao expoe detalhe interno.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayload"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "postAuthLogout",
        "summary": "Encerra a sessao atual",
        "tags": ["Autenticacao"],
        "responses": {
          "200": {
            "description": "Logout processado. O cookie de sessao e expirado mesmo quando nao havia sessao ativa.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "Set-Cookie": {
                "$ref": "#/components/headers/SessionCookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkPayload"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "ok": true
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro tecnico inesperado. A resposta nao expoe detalhe interno.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayload"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "summary": "Consulta a sessao autenticada atual",
        "tags": ["Autenticacao"],
        "responses": {
          "200": {
            "description": "Sessao autenticada encontrada. A resposta nao inclui token de sessao.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionPayload"
                },
                "examples": {
                  "authenticated": {
                    "value": {
                      "authenticated": true,
                      "user": {
                        "id": "019a0000-0000-7000-8000-000000000001",
                        "person_id": "019a0000-0000-7000-8000-000000000002",
                        "is_technical_superuser": false
                      },
                      "memberships": [
                        {
                          "id": "019a0000-0000-7000-8000-000000000003",
                          "team_id": "019a0000-0000-7000-8000-000000000004",
                          "role": "MEMBRO",
                          "scope": {
                            "type": "GRE",
                            "gre_code": "GRE-01"
                          }
                        }
                      ],
                      "session": {
                        "expires_at": "2026-09-14T20:00:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sessao ausente, expirada, revogada ou usuario sem acesso ativo.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "Set-Cookie": {
                "$ref": "#/components/headers/SessionCookie"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleErrorPayload"
                },
                "examples": {
                  "unauthenticated": {
                    "value": {
                      "error": "Sessao nao autenticada."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro tecnico inesperado. A resposta nao expoe detalhe interno.",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayload"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "CorrelationId": {
        "description": "Identificador de correlacao retornado tambem no log estruturado.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "SessionCookie": {
        "description": "Cookie HttpOnly contendo o token opaco da sessao.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Tempo em segundos para nova tentativa de login.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "HealthPayload": {
        "type": "object",
        "required": ["service", "status", "timestamp"],
        "properties": {
          "service": {
            "type": "string",
            "const": "gestor-gmap"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ReadinessPayload": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HealthPayload"
          },
          {
            "type": "object",
            "required": ["dependencies"],
            "properties": {
              "dependencies": {
                "type": "object",
                "required": ["database"],
                "properties": {
                  "database": {
                    "$ref": "#/components/schemas/HealthStatus"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "HealthStatus": {
        "type": "string",
        "enum": ["ok", "error"]
      },
      "ErrorPayload": {
        "type": "object",
        "required": ["error", "correlation_id"],
        "properties": {
          "error": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "required": ["loginIdentifier", "password"],
        "properties": {
          "loginIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "LoginSuccessPayload": {
        "type": "object",
        "required": ["ok", "expires_at"],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "SimpleErrorPayload": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OkPayload": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "additionalProperties": false
      },
      "AuthScope": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "const": "GLOBAL"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "gre_code"],
            "properties": {
              "type": {
                "type": "string",
                "const": "GRE"
              },
              "gre_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "AuthMembership": {
        "type": "object",
        "required": ["id", "team_id", "role", "scope"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "team_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": ["MEMBRO", "LIDER"]
          },
          "scope": {
            "$ref": "#/components/schemas/AuthScope"
          }
        },
        "additionalProperties": false
      },
      "AuthSessionPayload": {
        "type": "object",
        "required": ["authenticated", "user", "memberships", "session"],
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": true
          },
          "user": {
            "type": "object",
            "required": ["id", "person_id", "is_technical_superuser"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "person_id": {
                "type": "string",
                "format": "uuid"
              },
              "is_technical_superuser": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthMembership"
            }
          },
          "session": {
            "type": "object",
            "required": ["expires_at"],
            "properties": {
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
